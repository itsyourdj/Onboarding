# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# APP_ENV: dev = local Postgres, prod = provisioned/semantic backend.
APP_ENV=dev
PORT=4000

# DATA_SOURCE: postgres (local CSV-backed dev) | semantic (DataOS/Cube.js live)
DATA_SOURCE=postgres

# ── Local Postgres (used when DATA_SOURCE=postgres) ─────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=customer_health
PGUSER=your_user
PGPASSWORD=
# Folder with the source CSVs, ingested by `npm run load`.
DATA_DIR=/absolute/path/to/output_incremental

# ── Semantic layer (used when DATA_SOURCE=semantic) ─────────────────────────
# SEMANTIC_API_URL is the data-product BASE; the client appends:
#   POST {base}/api/v1/query/semantic/rest  → GET .../statement/{id} → .../result
# Example:
# SEMANTIC_API_URL=https://clienttech.instance.dataos.cloud/vulcan/tenants/otis-onboarding/data-products/otis-onboarding-service-analytic-enhanced
SEMANTIC_API_URL=https://<host>/vulcan/tenants/<tenant>/data-products/<tenant>-<data-product-name>
SEMANTIC_API_TOKEN=<your-dataos-api-token>
# Optional tuning (uncomment to override defaults)
# SEMANTIC_CONCURRENCY=3           # parallel async queries (gateway throttles high values)
# SEMANTIC_PAGE_SIZE=50000         # rows per page before offset pagination kicks in
# SEMANTIC_POLL_TIMEOUT_MS=120000  # max wait for an async statement to finish
# CACHE_TTL_MS=60000               # how long the backend holds the scored snapshot
#                                  # (default 60s dev / 600s prod; e.g. 7200000 = 2h for demos)
